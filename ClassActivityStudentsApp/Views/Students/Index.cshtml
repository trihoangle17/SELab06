@model IEnumerable<ClassActivityStudentsApp.Models.Student>
@{ViewBag.Title="Students";}<div class="head"><div><small>CLASS ACTIVITY</small><h1>Student Management</h1></div>@Html.ActionLink("+ Add student","Create",null,new{@class="btn"})</div><section><table><thead><tr><th>ID</th><th>First name</th><th>Last name</th><th>Email</th><th>Enrollment date</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.StudentID</td><td>@x.FirstName</td><td>@x.LastName</td><td>@x.Email</td><td>@x.EnrollmentDate.ToString("yyyy-MM-dd")</td><td>@Html.ActionLink("Edit","Edit",new{id=x.StudentID}) @using(Html.BeginForm("Delete","Students",new{id=x.StudentID},FormMethod.Post,new{@class="inline"})){@Html.AntiForgeryToken()<button>Delete</button>}</td></tr>}</tbody></table></section>
