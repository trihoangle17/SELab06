@model ClassActivityStudentsApp.Models.Student
@{bool create=Model.StudentID==0;ViewBag.Title=create?"Add student":"Edit student";}<section class="form"><h1>@ViewBag.Title</h1>@using(Html.BeginForm(create?"Create":"Edit","Students")){@Html.AntiForgeryToken()if(!create){@Html.HiddenFor(x=>x.StudentID)}<label>First name</label>@Html.TextBoxFor(x=>x.FirstName)<label>Last name</label>@Html.TextBoxFor(x=>x.LastName)<label>Email</label>@Html.TextBoxFor(x=>x.Email)<label>Enrollment date</label>@Html.TextBoxFor(x=>x.EnrollmentDate,"{0:yyyy-MM-dd}",new{type="date"})<button class="btn">Save</button> @Html.ActionLink("Cancel","Index")}</section>
